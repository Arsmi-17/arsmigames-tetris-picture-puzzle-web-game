// Cloudflare Worker serving the game, the admin page, the catalog and event intake.
// Replace every REPLACE_ME value before deploying; see docs/DEPLOYMENT.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shape-reveal",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },

  // Production hostnames. Uncomment once the zone is on Cloudflare.
  // "routes": [
  //   { "pattern": "play.example.com", "custom_domain": true },
  //   { "pattern": "admin.example.com", "custom_domain": true }
  // ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // These paths must pass through the Worker: admin auth, catalog, events.
    "run_worker_first": ["/admin", "/admin/*", "/api/*", "/catalog.json"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shape-reveal-catalog",
      "database_id": "REPLACE_ME_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    // Private bucket for the generated catalog JSON. Picture files live in a
    // separate public bucket behind the image custom domain.
    { "binding": "CATALOG_BUCKET", "bucket_name": "shape-reveal-catalog" }
  ],

  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "shape_reveal_events" }
  ],

  // Per-IP limit on /api/events. The IP is only the limiter key; it is never stored.
  "ratelimits": [
    { "name": "EVENTS_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],

  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_ME.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_ME_ACCESS_APPLICATION_AUD",
    "ADMIN_EMAILS": "",
    "IMAGE_HOSTS": "images.example.com",
    "GAME_ORIGIN": "https://play.example.com"
  }
}

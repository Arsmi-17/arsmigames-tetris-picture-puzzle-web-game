// Cloudflare Pages project: the game's static build plus an advanced-mode
// _worker.js (worker/src) that serves /catalog.json from Supabase,
// /api/events, and the signed-in /admin. See docs/DEPLOYMENT.md.
//
// Secrets (set with `npx wrangler pages secret put NAME`, never in this file):
//   SUPABASE_SERVICE_ROLE_KEY   Supabase service_role key
//   ADMIN_EMAIL                 admin sign-in email
//   ADMIN_KEY                   admin sign-in key, at least 4 characters
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arsmigames-tetris-picture-puzzle-web-game",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2025-10-01",

  // Gameplay analytics (optional). Enable Analytics Engine in the Cloudflare
  // dashboard (Workers & Pages -> Analytics Engine) first, then uncomment.
  // Without it, /api/events still accepts events but does not store them.
  // "analytics_engine_datasets": [
  //   { "binding": "ANALYTICS", "dataset": "shape_reveal_events" }
  // ],

  "vars": {
    "SUPABASE_URL": "https://REPLACE_ME.supabase.co",
    // Empty allows image links from any https website.
    "IMAGE_HOSTS": "",
    "GAME_ORIGIN": "https://arsmigames-tetris-picture-puzzle-web-game.pages.dev"
  }
}
